# === LLM API 配置（DeepSeek / GLM 二选一，均兼容 OpenAI SDK） ===
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 排除，禁止提交
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# === GitHub API（可选：提高搜索接口速率限制，未设置时按 10 次/分钟匿名配额） ===
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx

# === GitHub API 镜像前缀（解决国内直连问题，代码自动追加 /search/repositories） ===
# 留空则直连 api.github.com；国内网络建议配置镜像
# GITHUB_API_MIRROR=https://gh-proxy.com/https://api.github.com

# === ClawBot 推送（可选） ===
CLAWBOT_BOT_TOKEN=123456:ABC-DEF
CLAWBOT_CHAT_ID=-1001234567890

# === 飞书推送（可选） ===
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx